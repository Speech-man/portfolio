    {
      "parameters": {
        "jsCode": "// Get the applicant's information from the previous node\nconst applicant = $input.item.json;\n\n// Applicant details\nconst fullName = applicant[\"Full Name\"] || applicant[\"Name\"] || \"\";\nconst email = applicant[\"Email\"] || applicant[\"Email Address\"] || \"\";\nconst position = applicant[\"Position Applied For\"] || applicant[\"Position\"] || \"\";\n\n// Email subject\nconst subject = `Application Update${position ? ` – ${position}` : \"\"}`;\n\n// Rejection email\nconst body = `Dear ${fullName},\n\nThank you for taking the time to apply${position ? ` for the ${position} position` : \"\"}.\n\nWe appreciate your interest in joining our team and the effort you put into your application.\n\nAfter careful consideration, we regret to inform you that you have not been selected to proceed to the interview stage at this time.\n\nWe sincerely appreciate your interest and wish you the very best in your future opportunities.\n\nBest regards,\nRecruitment Team`;\n\nreturn {\n  json: {\n    fullName: fullName,\n    email: email,\n    position: position,\n    subject: subject,\n    body: body\n  }\n};"
      },
